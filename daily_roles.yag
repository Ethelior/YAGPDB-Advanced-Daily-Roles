{{/*
================================================
 GameCentral Daily System
 Version: 1.0.0

 Author: Ethelior
 Project: GameCentral

 Features
 ✔ Daily Roles
 ✔ Cooldown
 ✔ Rarity System
 ✔ Troll Event
 ✔ Daily Streak
 ✔ Pity System
 ✔ Weekend Bonus
 ✔ Future Ready

 License:
 MIT
================================================
*/}}

{{/* ======================================
                CONFIG
====================================== */}}

{{$config := sdict
    "cooldownKey" "gc_daily_cooldown"
    "pityKey" "gc_daily_pity"
    "streakKey" "gc_daily_streak"

    "cooldown" 86400

    "commonChance" 60
    "rareChance" 88
    "epicChance" 98

    "trollChance" 5

    "weekendBonus" 5
    "maxPityBonus" 5

    "successColor" 3447003
    "cooldownColor" 16753920
    "trollColor" 15158332
    "legendaryColor" 15844367

    "footerText" "GameCentral Daily System"

    "titleReward" "🎁 Daily Reward"
    "titleCooldown" "⏳ Daily Cooldown"
    "titleTroll" "💀 Daily Troll"
    "titleLegendary" "🌟 LEGENDARY DROP!"
}}

{{/* ======================================
            TROLL MESSAGES
====================================== */}}

{{$trollMessages := cslice
"💀 Ο διανομέας των Daily Roles πήγε για καφέ. Ξαναπέρασε αύριο."
"🎁 Άνοιξες το κουτί... αλλά ήταν άδειο."
"🤡 Συγχαρητήρια! Κέρδισες... απολύτως τίποτα."
"🐌 Ο courier έχασε το Daily Role σου."
"🪙 Το νόμισμα έπεσε... αλλά έχασες."
"👻 Το Daily Role εξαφανίστηκε πριν φτάσει σε εσένα."
"💣 Έπεσες σε Trap Card!"
"🎰 Critical Miss!"
"👑 Ο βασιλιάς αποφάσισε να κρατήσει το Daily Role."
"🦝 Ένα ρακούν έκλεψε το κουτί σου."
}}

{{/* ======================================
        GLOBAL VARIABLES
====================================== */}}

{{$cooldownKey := $config.cooldownKey}}
{{$pityKey := $config.pityKey}}
{{$streakKey := $config.streakKey}}

{{$common := cslice
1524022878738059364
1524023080475824271
1524023154308157521
1524023221421211741
1524023289809338428
1524023348672331806
1524023419090243745
1524023481556271185
1524023542910423091
1524023603191087316
}}

{{$rare := cslice
1524023670962389012
1524023731029151906
1524023791053832366
1524023863862886420
1524023920326611144
1524023979109515304
}}

{{$epic := cslice
1396486705074405479
1524024041932066866
1524024101738385529
}}

{{$legendary := cslice
1524024171917480087
}}
{{/* ======================================
              COOLDOWN CHECK
====================================== */}}

{{$cd := dbGet .User.ID $cooldownKey}}

{{if $cd}}

{{$seconds := sub $cd.ExpiresAt.Unix currentTime.Unix}}

{{$hours := toInt (div $seconds 3600)}}
{{$minutes := toInt (div (mod $seconds 3600) 60)}}
{{$secs := toInt (mod $seconds 60)}}

{{/*
=========================================
ΕΛΛΑΔΑ

☀ Καλοκαίρι:
Add 10800e9 (+3)

❄ Χειμώνας:
Add 7200e9 (+2)

Αλλάζεις μόνο την παρακάτω γραμμή.
=========================================
*/}}

{{$next := ($cd.ExpiresAt.Add 10800e9).Format "02/01/2006 στις 15:04:05"}}

{{sendMessage nil (complexMessage
"content" .User.Mention
"embed" (cembed
"title" $config.titleCooldown
"description" (joinStr ""

"🎁 Έχεις ήδη πάρει το σημερινό σου **Daily Role**.\n\n"

"⏳ **Υπολειπόμενος χρόνος:**\n"

"🕒 **" $hours "** ώρες\n"
"🕑 **" $minutes "** λεπτά\n"
"🕐 **" $secs "** δευτερόλεπτα\n\n"

"📅 **Διαθέσιμο ξανά:**\n"
"**" $next "**\n\n"

"🎮 Χρησιμοποίησε ξανά την εντολή **!daily** όταν λήξει το cooldown."

)
"color" $config.cooldownColor
"footer" (sdict
"text" $config.footerText
)
)
)}}

{{else}}

{{/* ======================================
        LOAD USER DATA
====================================== */}}

{{$weekBonus := 0}}

{{$weekday := currentTime.Weekday}}

{{if or (eq $weekday 5) (eq $weekday 6) (eq $weekday 0)}}
    {{$weekBonus = $config.weekendBonus}}
{{end}}

{{$pity := 0}}

{{$pityDB := dbGet .User.ID $pityKey}}

{{if $pityDB}}
    {{$pity = toInt $pityDB.Value}}
{{end}}

{{$pityBonus := div $pity 5}}

{{if gt $pityBonus $config.maxPityBonus}}
    {{$pityBonus = $config.maxPityBonus}}
{{end}}

{{$chance := randInt 1 (sub 101 $weekBonus)}}

{{$pool := $common}}
{{$rarity := "🟢 Common"}}

{{$newRole := 0}}
{{$oldRole := "Κανένας"}}

{{$trollRoll := randInt 1 101}}
{{/* ======================================
            RARITY ROLL
====================================== */}}

{{if le $trollRoll $config.trollChance}}

    {{$rarity = "💀 Troll"}}

{{else}}

    {{if le $chance $config.commonChance}}

        {{$pool = $common}}
        {{$rarity = "🟢 Common"}}

    {{else if le $chance $config.rareChance}}

        {{$pool = $rare}}
        {{$rarity = "🔵 Rare"}}

    {{else if le $chance (sub $config.epicChance $pityBonus)}}

        {{$pool = $epic}}
        {{$rarity = "🟣 Epic"}}

        {{dbSet .User.ID $pityKey 0}}

    {{else}}

        {{$pool = $legendary}}
        {{$rarity = "🟡 Legendary"}}

        {{dbSet .User.ID $pityKey 0}}

    {{end}}

    {{$newRole = index $pool (randInt 0 (len $pool))}}

{{end}}

{{/* ======================================
      FIND PREVIOUS DAILY ROLE
====================================== */}}

{{range $common}}
    {{if hasRoleID .}}
        {{$oldRole = (getRole .).Name}}
    {{end}}
{{end}}

{{range $rare}}
    {{if hasRoleID .}}
        {{$oldRole = (getRole .).Name}}
    {{end}}
{{end}}

{{range $epic}}
    {{if hasRoleID .}}
        {{$oldRole = (getRole .).Name}}
    {{end}}
{{end}}

{{range $legendary}}
    {{if hasRoleID .}}
        {{$oldRole = (getRole .).Name}}
    {{end}}
{{end}}
{{/* ======================================
              TROLL EVENT
====================================== */}}

{{if eq $rarity "💀 Troll"}}

    {{/* Remove previous Daily Role */}}

    {{range $common}}
        {{if hasRoleID .}}
            {{removeRoleID .}}
        {{end}}
    {{end}}

    {{range $rare}}
        {{if hasRoleID .}}
            {{removeRoleID .}}
        {{end}}
    {{end}}

    {{range $epic}}
        {{if hasRoleID .}}
            {{removeRoleID .}}
        {{end}}
    {{end}}

    {{range $legendary}}
        {{if hasRoleID .}}
            {{removeRoleID .}}
        {{end}}
    {{end}}

    {{dbSetExpire .User.ID $cooldownKey true $config.cooldown}}

    {{sendMessage nil (complexMessage
        "content" .User.Mention
        "embed" (cembed
            "title" $config.titleTroll
            "description" (joinStr ""

                (index $trollMessages (randInt 0 (len $trollMessages)))
"\n\n🏅 Lost Daily Role:\n**"
$oldRole
"**"
"\n\n💀 Better luck next time!"
            )
            "color" $config.trollColor
            "footer" (sdict
                "text" $config.footerText
            )
        )
    )}}

{{else}}
{{/* ======================================
        REMOVE OLD DAILY ROLE
====================================== */}}

{{range $common}}
    {{if hasRoleID .}}
        {{removeRoleID .}}
    {{end}}
{{end}}

{{range $rare}}
    {{if hasRoleID .}}
        {{removeRoleID .}}
    {{end}}
{{end}}

{{range $epic}}
    {{if hasRoleID .}}
        {{removeRoleID .}}
    {{end}}
{{end}}

{{range $legendary}}
    {{if hasRoleID .}}
        {{removeRoleID .}}
    {{end}}
{{end}}

{{/* ======================================
            GIVE NEW ROLE
====================================== */}}

{{addRoleID $newRole}}

{{$role := getRole $newRole}}
{{$roleName := "Unknown"}}

{{if $role}}
    {{$roleName = $role.Name}}
{{end}}

{{/* ======================================
            UPDATE PITY
====================================== */}}

{{if and (ne $rarity "🟣 Epic") (ne $rarity "🟡 Legendary")}}
    {{dbSet .User.ID $pityKey (add $pity 1)}}
{{end}}

{{/* ======================================
            DAILY STREAK
====================================== */}}

{{$streak := 1}}

{{$streakDB := dbGet .User.ID $streakKey}}

{{if $streakDB}}
    {{$streak = add (toInt $streakDB.Value) 1}}
{{end}}

{{dbSet .User.ID $streakKey $streak}}

{{dbSetExpire .User.ID $cooldownKey true $config.cooldown}}
{{/* ======================================
            REWARD EMBED
====================================== */}}

{{$rewardColor := $config.successColor}}

{{if eq $rarity "🟡 Legendary"}}
    {{$rewardColor = $config.legendaryColor}}
{{end}}

{{sendMessage nil (complexMessage
    "content" .User.Mention
    "embed" (cembed
        "title" $config.titleReward
        "description" (joinStr ""

"🎉 Συγχαρητήρια!\n\n"

"🏅 Κέρδισες:\n"
"**" $roleName "**\n\n"

"🎲 Σπανιότητα:\n"
$rarity

"\n\n🔥 Daily Streak: **"
$streak
"**"

"\n\n⏰ Έλα ξανά αύριο για νέο Daily!"

        )
        "color" $rewardColor
        "footer" (sdict
            "text" $config.footerText
        )
    )
)}}

{{end}}
{{end}}